# Salin jadi web/.env.local untuk dev, atau isi di apphosting.yaml / setelan hosting.
# Nilai NEXT_PUBLIC_* BUKAN rahasia (memang dikirim ke browser); keamanan dijaga
# firestore.rules dan pemeriksaan server. Ambil dari Firebase Console →
# Project settings → General → Your apps → Web app → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Kosong = login & gerbang mati, paket berbayar tertutup (gagal aman).

# Hanya untuk hosting di luar Google (mis. Vercel): JSON service account, satu baris.
# RAHASIA: jangan di-commit. Di Firebase App Hosting tidak perlu (kredensial otomatis).
# FIREBASE_SERVICE_ACCOUNT=

# Uji lokal dengan Firebase Emulator (lihat docs/firebase.md bagian "Uji di emulator").
# NEXT_PUBLIC_FIREBASE_EMULATOR=1
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
